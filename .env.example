# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
# Production: set hosting secrets before build/start, or securely provision
# .env.production.local on the server. See PAYMENT_SETUP.md for DevOps steps.

# SMTP provider settings (used by src/app/api/send-confirmation/route.ts)
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# What recipients see as the sender, and where "Reply" actually goes.
SMTP_FROM_EMAIL=notifications@t2upgrade.com
SMTP_FROM_NAME=T2Upgrade
SMTP_REPLY_TO=support@t2upgrade.com

# Razorpay — Dashboard → Settings → API Keys (test-mode keys, rzp_test_...,
# are fine and recommended until you're ready to go live).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Separate secret for signed payment.captured / order.paid webhook delivery.
RAZORPAY_WEBHOOK_SECRET=

# Optional server-side override; paid CRM submissions use this endpoint.
T2U_API_BASE_URL=https://t2upgrade.com/api
