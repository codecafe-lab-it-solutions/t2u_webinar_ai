# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real SMTP credentials.

# SMTP provider settings (used by src/app/api/send-confirmation/route.ts)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=support@t2upgrade.com
SMTP_PASSWORD=Support@t2u

# What recipients see as the sender, and where "Reply" actually goes.
SMTP_FROM_EMAIL=support@t2upgrade.com
SMTP_FROM_NAME=T2Upgrade
SMTP_REPLY_TO=support@t2upgrade.com
